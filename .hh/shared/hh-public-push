#!/usr/bin/env python3
"""Refuse a command that publishes until what it publishes has been read.

A Claude Code PreToolUse hook on Bash (diary decision 2026-11-20: the read
before a public push checked by a hook). It acts on three commands and passes
every other at once:

- `git push`, where the repository pushed to is public;
- `gh repo edit` making a repository public;
- `gh repo create` with `--public` and `--push`.

A push to a private repository passes, since the commit checks cover it. For
the others it writes what the command would make public to one file: for a
push, the messages and diffs of the commits the remote lacks, and for a new
public repository or a change of visibility, the whole history. It then
refuses, by exit status 2 with the reason on stderr, which Claude Code shows to
Claude, until the session's transcript holds Read calls on that file covering
every line of it. The file is named for a digest of its text, so a retry after
a new commit is a new file, to be read again.

What a push would send is asked of git itself, with `git push --dry-run`, and
what the remote has, with `git ls-remote`, so nothing rests on this script's
reading of a refspec. Where the visibility cannot be read, or the command
cannot be parsed, it refuses: a wrong refusal costs a read, a wrong pass
publishes.

The hook's input is JSON on stdin, of which it reads `tool_input.command`,
`cwd`, `transcript_path` and `scratchpad_dir`.
"""

import hashlib
import itertools
import json
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import cast

REFUSE = 2
# Read cuts a line longer than 2000 characters short, so longer lines are
# folded and every line of the file can be read whole.
WIDTH = 400
SEPARATORS = frozenset(";&|()")
REDIRECTS = frozenset("<>")
GIT_OPTIONS_WITH_A_VALUE = frozenset({"-c", "--git-dir", "--work-tree", "--namespace"})
QUIET = frozenset({"-q", "--quiet"})
DRY = frozenset({"-n", "--dry-run"})
NOT_PUBLIC = frozenset({"private", "internal", "local"})
LOG = (
    "log",
    "--cc",
    "--patch",
    "--no-color",
    "--no-ext-diff",
    "--no-textconv",
    "--format=fuller",
)
GITHUB = re.compile(r"github\.com[:/]+([^/\s]+)/([^/\s]+?)(?:\.git)?/?$")
NAMED_REPOSITORY = re.compile(
    r"^(?:.*github\.com[:/]+)?([\w.-]+)/([\w.-]+?)(?:\.git)?$"
)
HEREDOC = re.compile(r"(?<!<)<<(?!<)-?\s*[\"']?([A-Za-z_]\w*)")
UNPARSED = re.compile(r"\bgit\b.*\bpush\b|\bgh\s+repo\s+(?:edit|create)\b")


class RefusalError(Exception):
    """The command is refused, with the reason Claude is shown."""


@dataclass(frozen=True)
class Publish:
    """One command that may publish: its kind, its folder and its arguments."""

    kind: str
    folder: Path
    args: tuple[str, ...]


@dataclass(frozen=True)
class Done:
    """What a command gave."""

    rc: int
    out: str
    err: str


def run(*args: str, cwd: Path, stdin: str = "") -> Done:
    """Run a command found on PATH in cwd."""
    exe = shutil.which(args[0])
    if exe is None:
        msg = f"{args[0]} is not on PATH"
        raise RefusalError(msg)
    try:
        done = subprocess.run(
            [exe, *args[1:]],
            capture_output=True,
            text=True,
            errors="replace",
            check=False,
            cwd=cwd,
            input=stdin,
        )
    except OSError as err:
        msg = f"{' '.join(args[:2])} could not run in {cwd}: {err}"
        raise RefusalError(msg) from err
    return Done(done.returncode, done.stdout, done.stderr)


def without_heredocs(command: str) -> str:
    """Drop the body of each heredoc that `cat` or `tee` reads and does not pipe on.

    Such a body is a file's text, or a message, and no command. One that any
    other command reads, such as a shell, or that is piped to one, is kept, and
    is read as commands.
    """
    kept: list[str] = []
    until = None
    for line in command.splitlines():
        if until is not None:
            if line.strip() == until:
                until = None
            continue
        kept.append(line)
        opened = HEREDOC.search(line)
        if opened:
            reader = re.split(r"[;|&(]", line[: opened.start()])[-1].split()
            piped = "|" in line[opened.end() :]
            if reader[:1] in (["cat"], ["tee"]) and not piped:
                until = opened[1]
    return "\n".join(kept)


def segments(command: str) -> list[list[str]] | None:
    """Split a shell command into its simple commands, each a list of words.

    Redirections and heredocs' bodies are dropped. None when the command
    cannot be split, such as one with an unbalanced quote.
    """
    plain = without_heredocs(command).replace("\n", " ; ")
    lexer = shlex.shlex(plain, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    lexer.commenters = ""
    try:
        words = list(lexer)
    except ValueError:
        return None
    found: list[list[str]] = [[]]
    skip = False
    for word in words:
        if skip:
            skip = False
        elif set(word) <= SEPARATORS:
            found.append([])
        elif set(word) & REDIRECTS and set(word) <= REDIRECTS | {"&", "|"}:
            if found[-1] and found[-1][-1].isdigit():
                found[-1].pop()
            skip = True
        else:
            found[-1].append(word)
    return [segment for segment in found if segment]


def command_words(words: list[str]) -> list[str]:
    """Drop what precedes a command's name: assignments, `command` and `env`."""
    rest = list(words)
    while rest and (rest[0] in {"command", "env"} or re.match(r"^\w+=", rest[0])):
        rest.pop(0)
    return rest


def git_push(words: list[str], folder: Path) -> Publish | None:
    """Give the push in a git command's words, if it is one."""
    rest = list(words)
    while rest and rest[0].startswith("-"):
        option = rest.pop(0)
        if option == "-C" and rest:
            folder = folder / Path(rest.pop(0)).expanduser()
        elif option in GIT_OPTIONS_WITH_A_VALUE and rest:
            rest.pop(0)
    if rest[:1] != ["push"]:
        return None
    return Publish("push", folder, tuple(rest[1:]))


def makes_public(args: list[str]) -> bool:
    """Whether `gh repo edit`'s arguments set the visibility to public."""
    if "--visibility=public" in args:
        return True
    return any(
        flag == "--visibility" and value == "public"
        for flag, value in itertools.pairwise(args)
    )


def source_folder(args: list[str], folder: Path) -> Path:
    """Give the folder `gh repo create` takes its commits from."""
    for at, arg in enumerate(args):
        if arg.startswith("--source="):
            return folder / Path(arg.removeprefix("--source=")).expanduser()
        if arg in {"--source", "-s"} and at + 1 < len(args):
            return folder / Path(args[at + 1]).expanduser()
    return folder


def gh_publish(words: list[str], folder: Path) -> Publish | None:
    """Give what a gh command's words make public, if anything."""
    args = words[2:]
    if words[:2] == ["repo", "edit"] and makes_public(args):
        return Publish("visibility", folder, tuple(args))
    if words[:2] == ["repo", "create"] and "--public" in args and "--push" in args:
        return Publish("create", source_folder(args, folder), tuple(args))
    return None


def publishes(command: str, cwd: Path) -> list[Publish]:
    """List the commands in a shell command line that may publish."""
    split = segments(command)
    if split is None:
        if UNPARSED.search(without_heredocs(command)):
            msg = (
                "this command may publish and could not be read, for a quote left "
                "open or the like. Run the push, or the gh command, on its own."
            )
            raise RefusalError(msg)
        return []
    found: list[Publish] = []
    folder = cwd
    for segment in split:
        words = command_words(segment)
        publish = None
        if words[:1] == ["cd"] and len(words) > 1:
            folder = folder / Path(words[1]).expanduser()
        elif words[:1] == ["git"]:
            publish = git_push(words[1:], folder)
        elif words[:1] == ["gh"]:
            publish = gh_publish(words[1:], folder)
        if publish is not None:
            found.append(publish)
    return found


def visibility(url: str, cwd: Path) -> str:
    """Say how visible the repository at a remote's URL is.

    `public`, `private` or `internal` as GitHub gives it; `local` for a path on
    this machine; `unknown` for any other host, or when GitHub does not answer.
    """
    match = GITHUB.search(url)
    if match is None:
        local = url.startswith(("/", "./", "../", "file://"))
        return "local" if local else "unknown"
    asked = run(
        "gh", "api", f"repos/{match[1]}/{match[2]}", "--jq", ".visibility", cwd=cwd
    )
    answer = asked.out.strip()
    return answer if asked.rc == 0 and answer else "unknown"


def pushed(porcelain: str) -> tuple[str | None, list[str]]:
    """Read `git push --porcelain`: the remote's URL and the refs it would send."""
    url = None
    refs: list[str] = []
    for line in porcelain.splitlines():
        if line.startswith("To "):
            url = line.removeprefix("To ").strip()
            continue
        fields = line.split("\t")
        # `=` is up to date, `!` rejected, `-` a deletion: none sends commits.
        if len(fields) > 1 and fields[0] not in {"=", "!", "-"}:
            refs.append(fields[1].split(":")[0])
    return url, refs


def commits_here(shas: list[str], folder: Path) -> list[str]:
    """Keep the object names this repository holds as commits."""
    checked = run(
        "git",
        "cat-file",
        "--batch-check=%(objectname) %(objecttype)",
        cwd=folder,
        stdin="".join(f"{sha}^{{commit}}\n" for sha in shas),
    )
    return [
        line.split()[0] for line in checked.out.splitlines() if line.endswith(" commit")
    ]


def remote_commits(url: str, folder: Path) -> list[str]:
    """List the commits the remote's refs name that this repository also holds."""
    listed = run("git", "ls-remote", url, cwd=folder)
    if listed.rc != 0:
        msg = f"what {url} holds could not be listed:\n{listed.err}"
        raise RefusalError(msg)
    shas = sorted({line.split()[0] for line in listed.out.splitlines() if line.strip()})
    return commits_here(shas, folder)


def tag_texts(refs: list[str], folder: Path) -> str:
    """Give the text of each annotated tag among the refs."""
    texts: list[str] = []
    for ref in refs:
        kind = run("git", "cat-file", "-t", ref, cwd=folder)
        if kind.out.strip() == "tag":
            texts.append(run("git", "cat-file", "-p", ref, cwd=folder).out)
    return "\n".join(texts)


def nowhere_public(args: list[str], folder: Path) -> bool:
    """Whether a push git could not try has no public place to go.

    A push of what an earlier part of the command line makes, such as a new
    tag, cannot be tried before it. It passes where every remote of the
    repository, and the place the push names if that is no remote, is known not
    to be public.
    """
    listed = run(
        "git", "config", "--get-regexp", r"^remote\..*\.(push)?url$", cwd=folder
    )
    remotes = {
        line.split(" ", 1)[0].split(".")[1]: line.split(" ", 1)[1]
        for line in listed.out.splitlines()
        if " " in line
    }
    places = set(remotes.values())
    named = next((arg for arg in args if not arg.startswith("-")), None)
    if named is not None and named not in remotes:
        places.add(named)
    return bool(places) and all(
        visibility(place, folder) in NOT_PUBLIC for place in places
    )


def push_text(publish: Publish) -> tuple[str, str]:
    """Give where a push goes and what it would make public there, if anything."""
    if DRY & set(publish.args):
        return "", ""
    args = [arg for arg in publish.args if arg not in QUIET]
    tried = run(
        "git",
        "push",
        "--dry-run",
        "--porcelain",
        "--no-verify",
        *args,
        cwd=publish.folder,
    )
    url, refs = pushed(tried.out)
    if url is None:
        if nowhere_public(args, publish.folder):
            return "", ""
        msg = f"the push could not be tried with --dry-run:\n{tried.err}"
        raise RefusalError(msg)
    if not refs or visibility(url, publish.folder) in NOT_PUBLIC:
        return url, ""
    tips = commits_here(refs, publish.folder)
    have = remote_commits(url, publish.folder)
    log = run("git", *LOG, *tips, "--not", *have, cwd=publish.folder) if tips else None
    text = tag_texts(refs, publish.folder) + (log.out if log else "")
    return url, text


def whole_history(publish: Publish) -> tuple[str, str]:
    """Give the repository and its whole history, for one about to become public."""
    folder = publish.folder
    origin = run("git", "remote", "get-url", "origin", cwd=folder)
    url = origin.out.strip() if origin.rc == 0 else str(folder)
    if publish.kind == "visibility":
        here = GITHUB.search(url)
        for arg in publish.args:
            named = None if arg.startswith("-") else NAMED_REPOSITORY.match(arg)
            if named and (here is None or named.groups() != here.groups()):
                msg = (
                    f"{arg} is not the repository of {folder}. Make a repository "
                    "public from its own checkout, so its history can be read."
                )
                raise RefusalError(msg)
        if visibility(url, folder) == "public":
            return url, ""
    log = run("git", *LOG, "--all", cwd=folder)
    if log.rc != 0:
        msg = f"the history in {folder} could not be read:\n{log.err}"
        raise RefusalError(msg)
    return url, log.out


def folded(text: str) -> list[str]:
    """Split text into lines no longer than WIDTH, folding the longer ones."""
    lines: list[str] = []
    for line in text.splitlines():
        lines.extend(line[at : at + WIDTH] for at in range(0, len(line), WIDTH))
        if not line:
            lines.append("")
    return lines


def reads(transcript: Path, file: Path) -> list[tuple[int, int]]:
    """List the line ranges of the file that the transcript's Read calls returned."""
    spans: list[tuple[int, int]] = []
    try:
        text = transcript.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return spans
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        entry = cast("dict[str, object]", event)
        result = entry.get("toolUseResult")
        if entry.get("isSidechain") is True or not isinstance(result, dict):
            continue
        result = cast("dict[str, object]", result)
        read = result.get("file")
        if result.get("type") != "text" or not isinstance(read, dict):
            continue
        read = cast("dict[str, object]", read)
        start, count = read.get("startLine"), read.get("numLines")
        if (
            read.get("filePath") == str(file)
            and isinstance(start, int)
            and isinstance(count, int)
        ):
            spans.append((start, start + count - 1))
    return spans


def unread(total: int, spans: list[tuple[int, int]]) -> list[tuple[int, int]]:
    """Give the ranges of lines 1 to total that no span covers."""
    gaps: list[tuple[int, int]] = []
    at = 1
    for start, end in sorted(spans):
        if start > at:
            gaps.append((at, min(start - 1, total)))
        at = max(at, end + 1)
        if at > total:
            break
    if at <= total:
        gaps.append((at, total))
    return [gap for gap in gaps if gap[0] <= gap[1]]


def gate(url: str, text: str, payload: dict[str, object]) -> None:
    """Refuse unless the session has read every line of what would be public."""
    lines = [f"What would become public at {url}:", "", *folded(text)]
    body = "\n".join(lines) + "\n"
    digest = hashlib.sha256(body.encode()).hexdigest()[:16]
    scratch = payload.get("scratchpad_dir")
    folder = Path(scratch) if isinstance(scratch, str) and scratch else None
    if folder is None or not folder.is_dir():
        folder = Path(tempfile.gettempdir()) / "hh-public-push"
        folder.mkdir(parents=True, exist_ok=True)
    file = folder / f"public-push-{digest}.txt"
    if not file.exists():
        file.write_text(body, encoding="utf-8")
    transcript = payload.get("transcript_path")
    spans = reads(Path(transcript), file) if isinstance(transcript, str) else []
    gaps = unread(len(lines), spans)
    if gaps:
        ranges = ", ".join(f"{start}-{end}" for start, end in gaps)
        msg = (
            f"this would publish to {url}, which is not private. Everything it "
            f"would make public is in {file}, {len(lines)} lines. Read that file "
            "in full with the Read tool, in this session and not a subagent, for "
            "secrets and for the operator's infrastructure, then run the command "
            f"again. Lines not yet read: {ranges}."
        )
        raise RefusalError(msg)


def check(payload: dict[str, object]) -> None:
    """Refuse the hook's command when it publishes what has not been read."""
    tool_input = payload.get("tool_input")
    if not isinstance(tool_input, dict):
        return
    command = cast("dict[str, object]", tool_input).get("command")
    if not isinstance(command, str) or not ("push" in command or "repo" in command):
        return
    cwd = payload.get("cwd")
    start = Path(cwd) if isinstance(cwd, str) and cwd else Path.cwd()
    for publish in publishes(command, start):
        url, text = (
            push_text(publish) if publish.kind == "push" else whole_history(publish)
        )
        if text:
            gate(url, text, payload)


def main() -> int:
    """Read the hook's input and answer with its exit status."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return 0
    if not isinstance(payload, dict):
        return 0
    try:
        check(cast("dict[str, object]", payload))
    except RefusalError as refusal:
        print(f"hh-public-push: {refusal}", file=sys.stderr)
        return REFUSE
    return 0


if __name__ == "__main__":
    sys.exit(main())
